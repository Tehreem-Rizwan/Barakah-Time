rules_version = '2';

// Barakah Time — every document lives under users/{uid} and is only
// readable/writable by that signed-in user.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function incoming() { return request.resource.data; }
    // Optional fields may be absent or null.
    function optString(field, maxLen) {
      return !(field in incoming()) || incoming()[field] == null ||
        (incoming()[field] is string && incoming()[field].size() <= maxLen);
    }
    function optNumber(field) {
      return !(field in incoming()) || incoming()[field] == null ||
        incoming()[field] is number;
    }
    function optBool(field) {
      return !(field in incoming()) || incoming()[field] == null ||
        incoming()[field] is bool;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && optString('name', 100)
        && optString('email', 320)
        && optString('profilePicUrl', 2048)
        && optString('lastActiveDay', 8)
        && (!('totalPoints' in incoming()) ||
            (incoming().totalPoints is int && incoming().totalPoints >= 0))
        && (!('longestStreak' in incoming()) ||
            (incoming().longestStreak is int && incoming().longestStreak >= 0));

      match /activities/{activityId} {
        allow read, delete: if isOwner(uid);
        // Activities are immutable once written (points are counted once).
        allow create: if isOwner(uid)
          && activityId.size() <= 200
          && incoming().type is string && incoming().type.size() <= 32
          && optString('subType', 64)
          && incoming().points is int
          && incoming().points >= 0 && incoming().points <= 100
          && incoming().timestamp is timestamp
          && incoming().day is string && incoming().day.size() == 8;
        allow update: if false;
      }

      match /saved_verses/{verseId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && incoming().surahNumber is int
          && incoming().surahNumber >= 1 && incoming().surahNumber <= 114
          && incoming().ayahNumber is int
          && incoming().ayahNumber >= 1 && incoming().ayahNumber <= 286
          && incoming().text is string && incoming().text.size() <= 10000
          && optString('translation', 20000)
          && optString('surahName', 200);
      }

      match /badges/{badgeId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && badgeId.size() <= 64;
      }

      match /settings/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && optString('calculationMethod', 64)
          && optString('asrMadhab', 16)
          && optString('manualLocation', 200)
          && optString('languageCode', 8)
          && optBool('useAutoLocation')
          && optBool('notificationsEnabled')
          && optBool('adhanSoundEnabled')
          && optNumber('manualLatitude')
          && optNumber('manualLongitude')
          && optNumber('quranFontSize');
      }

      match /state/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && (!('count' in incoming()) ||
              (incoming().count is int && incoming().count >= 0))
          && (!('loggedCount' in incoming()) ||
              (incoming().loggedCount is int && incoming().loggedCount >= 0));
      }

      // The user's own list of Esaal-e-Sawab pages.
      match /memorials/{memorialId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && memorialId.size() == 8
          && optString('name', 300)
          && optBool('owner');
      }
    }

    // Esaal-e-Sawab pages, shared by code. Anyone signed in who knows the
    // code (a random 8-character id) can open one and contribute; pages
    // can't be listed or searched.
    match /memorials/{memorialId} {
      function memorial() { return resource.data; }
      function ownsIt() { return signedIn() && memorial().ownerUid == request.auth.uid; }

      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && memorialId.size() == 8
        && incoming().ownerUid == request.auth.uid
        && incoming().name is string
        && incoming().name.size() > 0 && incoming().name.size() <= 300
        && optString('subtitle', 450)
        && incoming().goals is map && incoming().goals.size() <= 10
        && incoming().khatams == 0;
      allow delete: if ownsIt();
      // Owner: anything except ownership. Others: one change at a time,
      // and only their own: take / give back / finish their own para,
      // add to one dhikr count, or close a finished khatam.
      allow update: if signedIn()
        && incoming().ownerUid == memorial().ownerUid
        && incoming().name is string && incoming().name.size() <= 300
        && incoming().khatams is int
        && incoming().khatams >= memorial().khatams
        && incoming().khatams <= memorial().khatams + 1
        && (ownsIt() || memberChangeOk());

      function memberChangeOk() {
        let keys = incoming().diff(memorial()).affectedKeys();
        return keys.hasOnly(['paras', 'counts', 'khatams', 'updatedAt'])
          && (!keys.hasAny(['counts']) || countsChangeOk())
          && (!keys.hasAny(['paras', 'khatams']) || parasChangeOk());
      }

      // Exactly one dhikr count goes up, by at most 1,000,000.
      function countsChangeOk() {
        let changed = incoming().counts.diff(memorial().counts).affectedKeys();
        let k = changed.toList()[0];
        return changed.size() == 1
          && incoming().counts[k] is int
          && incoming().counts[k] > memorial().counts.get(k, 0)
          && incoming().counts[k] <= memorial().counts.get(k, 0) + 1000000;
      }

      function parasChangeOk() {
        return khatamClosedOk() ||
          (incoming().khatams == memorial().khatams && oneParaChangeOk());
      }

      // The last para was finished: all 30 claimed, paras reset, +1 khatam.
      function khatamClosedOk() {
        return memorial().paras.size() == 30
          && incoming().paras.size() == 0
          && incoming().khatams == memorial().khatams + 1;
      }

      function oneParaChangeOk() {
        let changed = incoming().paras.diff(memorial().paras).affectedKeys();
        let k = changed.toList()[0];
        let before = memorial().paras.get(k, null);
        let after = incoming().paras.get(k, null);
        return changed.size() == 1 && (
          // take a free para
          (before == null && after != null
            && after.uid == request.auth.uid && after.done == false
            && after.name is string && after.name.size() <= 100) ||
          // give back your unfinished para
          (before != null && after == null
            && before.uid == request.auth.uid && before.done == false) ||
          // mark your para as read
          (before != null && after != null
            && before.uid == request.auth.uid && after.uid == request.auth.uid
            && before.done == false && after.done == true
            && after.name == before.name));
      }

      match /entries/{entryId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && incoming().uid == request.auth.uid
          && incoming().type in ['para', 'khatam', 'dhikr', 'deed']
          && incoming().text is string && incoming().text.size() <= 500
          && optString('name', 100)
          && optNumber('count')
          && exists(/databases/$(database)/documents/memorials/$(memorialId));
        allow delete: if signedIn() && (
          resource.data.uid == request.auth.uid ||
          get(/databases/$(database)/documents/memorials/$(memorialId)).data.ownerUid
            == request.auth.uid);
        allow update: if false;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
