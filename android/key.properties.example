# Copy to android/key.properties (git-ignored) and fill in your values.
# Create a keystore with:
#   keytool -genkey -v -keystore ~/barakah-upload-keystore.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias upload
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
# Absolute path, or relative to android/app/
storeFile=/Users/you/barakah-upload-keystore.jks
